generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN
  ORGANIZATION_ADMIN
  ORGANIZATION_MEMBER
}

enum OrganizationStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  ROLLED_BACK
}

model SubscriptionPackage {
  id              String          @id @default(uuid())
  name            String          @unique
  description     String?
  price           Decimal
  billingInterval BillingInterval
  features        Json
  isActive        Boolean         @default(true)

  stripePriceId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions        OrganizationSubscription[]
  pendingRegistrations PendingOrganizationRegistration[]
}

model Organization {
  id           String             @id @default(uuid())
  name         String
  contactEmail String?
  billingEmail String?
  status       OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  subscriptions OrganizationSubscription[]
  payments      Payment[]
  transactions  Transaction[]
}

model OrganizationSubscription {
  id             String @id @default(uuid())
  organizationId String
  packageId      String

  status    SubscriptionStatus @default(PENDING)
  startDate DateTime?
  endDate   DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  package      SubscriptionPackage @relation(fields: [packageId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([packageId])
  @@index([status])
}

model Payment {
  id             String        @id @default(uuid())
  organizationId String
  amount         Decimal
  currency       String        @default("usd")
  status         PaymentStatus @default(PENDING)

  stripePaymentId  String? @unique
  stripeCheckoutId String? @unique

  paidAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transaction  Transaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

model Transaction {
  id             String  @id @default(uuid())
  organizationId String
  paymentId      String? @unique

  amount   Decimal
  currency String            @default("usd")
  status   TransactionStatus @default(PENDING)

  stripeEventId String? @unique

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      Payment?     @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

model PendingOrganizationRegistration {
  id String @id @default(uuid())

  name         String
  contactEmail String?
  billingEmail String?

  userName     String
  userEmail    String
  userPassword String

  packageId        String
  stripeCheckoutId String? @unique

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package SubscriptionPackage @relation(fields: [packageId], references: [id])

  @@index([userEmail])
  @@index([packageId])
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  name     String
  password String
  role     UserRole @default(ORGANIZATION_MEMBER)

  organizationId String?

  refreshToken        String?
  resetToken          String?
  resetTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}